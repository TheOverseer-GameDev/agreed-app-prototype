  "rules": [
    {
      "id": "promo-lapse",
      "kind": "promo",
      "when": "catalog lists a higher regular or after-promo rate than the user pays now",
      "action": "negotiate",
      "actionLabel": "Negotiate script"
    },
    {
      "id": "unused-sub",
      "kind": "unused",
      "when": "the item is marked unused",
      "action": "cancel",
      "actionLabel": "Cancel script"
    },
    {
      "id": "video-overlap",
      "kind": "overlap",
      "when": "the user has three or more video streaming services",
      "action": "cancel",
      "actionLabel": "Cancel script"
    },
    {
      "id": "music-overlap",
      "kind": "overlap",
      "when": "the user has two or more music services",
      "action": "cancel",
      "actionLabel": "Cancel script"
    },
    {
      "id": "cheaper-tier",
      "kind": "tier",
      "when": "the catalog has a cheaper official or previous-on-account rate for the same billing cycle",
      "action": "guide",
      "actionLabel": "Switch plan guide"
    },
    {
      "id": "annual-vs-monthly",
      "kind": "annual",
      "when": "the catalog has both monthly and yearly prices for the same service",
      "action": "guide",
      "actionLabel": "Switch plan guide"
    },
    {
      "id": "renewal-increase",
      "kind": "insurance",
      "when": "the catalog or contract lists a higher renewal quote than the current premium",
      "action": "negotiate",
      "actionLabel": "Negotiate script"
    },
    {
      "id": "known-fee",
      "kind": "fee",
      "when": "the catalog lists an extra fee for an item the user has",
      "action": "negotiate",
      "actionLabel": "Negotiate script"
    },
    {
      "id": "trial-converting",
      "kind": "trial-end",
      "when": "a subscription is still in a free trial",
      "action": "cancel",
      "actionLabel": "Cancel script"
    },
    {
      "id": "bundle-prompt",
      "kind": "bundle",
      "when": "the user has both an internet and a phone item",
      "action": "guide",
      "actionLabel": "Switch plan guide",
      "estimate": false
    }
  ],
